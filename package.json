{
    "name": "ricardo-portfolio-api",
    "version": "1.0.0",
    "description": "REST API for my professional portfolio built with Node.js, Express, TypeScript and MongoDB.",
    "main": "dist/server.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "type-check": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "start": "node dist/server.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoseRicardoPE/ricardo-portfolio-api.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/JoseRicardoPE/ricardo-portfolio-api/issues"
    },
    "homepage": "https://github.com/JoseRicardoPE/ricardo-portfolio-api#readme",
    "dependencies": {
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "mongoose": "^9.10.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "6.0",
        "typescript-eslint": "^8.70.1"
    }
}
